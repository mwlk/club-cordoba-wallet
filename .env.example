DB_PASSWORD=change-me
HMAC_SECRET_KEY=change-me
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Puertos publicados en el host, por si 5432/5000/4200 ya están ocupados.
# Si cambiás UI_PORT, actualizá también CORS_ALLOWED_ORIGINS a juego
# (el frontend corre en ese puerto, y el backend solo permite ese origen).
DB_PORT=5432
API_PORT=5000
UI_PORT=4200

# Puertos internos (dentro de la red de Docker, no los del host de arriba).
# Solo hace falta tocarlos si algo dentro de la red también usa 8080/80.
# Si los cambiás, API_INTERNAL_PORT tiene que ser el MISMO valor en ambas
# líneas (lo usan tanto el backend como el proxy del frontend).
API_INTERNAL_PORT=8080
UI_INTERNAL_PORT=80
