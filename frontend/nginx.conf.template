server {
    listen ${UI_INTERNAL_PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Proxy a la API dentro de la red interna de Docker Compose: "api" se
    # resuelve por DNS al servicio del mismo nombre. Evita hardcodear host o
    # puerto en el frontend (ver docs/decisiones.md).
    # UI_INTERNAL_PORT/API_INTERNAL_PORT se resuelven vía envsubst (mecanismo
    # nativo de la imagen nginx:alpine) al arrancar el container, a partir de
    # este archivo copiado como /etc/nginx/templates/default.conf.template.
    location /api/ {
        proxy_pass http://api:${API_INTERNAL_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
